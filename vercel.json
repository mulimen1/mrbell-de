{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bwlmax.de"
        }
      ],
      "destination": "https://bwlmax.de/:path*",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/start",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/start.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ueber-uns",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ueber-uns.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/danke",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/danke.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/erfolg",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/erfolg.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/abbruch",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/abbruch.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dsgvo",
      "destination": "/datenschutz.html",
      "permanent": true
    },
    {
      "source": "/dsgvo.html",
      "destination": "/datenschutz.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "has": [
        {
          "type": "host",
          "value": "bwlmax.de"
        }
      ],
      "destination": "/tutor/img/favicon.ico"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bwlmax.de"
        }
      ],
      "destination": "/tutor/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.bwlmax.de"
        }
      ],
      "destination": "/tutor/index.html"
    },
    {
      "source": "/agb",
      "destination": "/agb.html"
    },
    {
      "source": "/avv",
      "destination": "/avv.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/datenschutz.html"
    },
    {
      "source": "/impressum",
      "destination": "/impressum.html"
    },
    {
      "source": "/widerruf",
      "destination": "/widerruf.html"
    },
    {
      "source": "/bewertung",
      "destination": "/bewertung.html"
    },
    {
      "source": "/tutor",
      "destination": "/tutor/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/((?!tutor).*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://hub.mrbell.de https://mrbell.app.n8n.cloud; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "bwlmax.de"
        }
      ]
    },
    {
      "source": "/tutor(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob: data:; connect-src 'self' https://hub.mrbell.de https://mrbell.app.n8n.cloud wss://api.elevenlabs.io; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bwlmax.de"
        }
      ],
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob: data:; connect-src 'self' https://hub.mrbell.de https://mrbell.app.n8n.cloud wss://api.elevenlabs.io; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/hotels.enc.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/partner/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
